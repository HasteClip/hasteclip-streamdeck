{
  "name": "hasteclip-streamdeck",
  "version": "0.2.0",
  "private": true,
  "description": "HasteClip for the Stream Deck: save clips, start and stop clipping, recording and streaming, switch scenes, show and hide sources, mute sounds.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.hasteclip.streamdeck\"",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "streamdeck validate com.hasteclip.streamdeck.sdPlugin",
    "pack": "npm run build && streamdeck pack com.hasteclip.streamdeck.sdPlugin --output dist --force",
    "version": "node scripts/sync-version.mjs && git add com.hasteclip.streamdeck.sdPlugin/manifest.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2",
    "@elgato/utils": "0.6.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~20.19.0",
    "fflate": "^0.8.2",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
